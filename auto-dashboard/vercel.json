{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/roadmachine", "destination": "/roadmachine/index.html" },
    { "source": "/((?!roadmachine/).*)", "destination": "/index.html" }
  ]
}
