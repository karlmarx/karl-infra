#!/usr/bin/env bash
# Silent-read secret getter for automation (option 3, "silent tier").
#
# Companion to keychain-get. Where keychain-get uses `-T ""` (every read pops a
# GUI Allow dialog — the prompt-injection tripwire for high-value secrets), this
# reads from the `karl-auto:` namespace whose items are created with
# `-T /usr/bin/security`, so the `security` CLI reads them WITHOUT a prompt.
#
# That makes it usable by unattended launchd/cron jobs and by long agent runs —
# at the cost of losing the per-read tripwire. So two guardrails apply:
#   1. ALLOWLIST  — only the names below resolve; a sloppy/injected call can't
#                   sweep the whole vault by guessing service names.
#   2. READ LOG   — every successful read is appended to the read log with the
#                   caller's pid/parent command, so reads are auditable.
#
# Only put secrets here whose blast radius you accept being read without a
# prompt. High-value secrets (KeePass master, financial, account-wide write)
# stay in the `-T ""` prompt tier via keychain-get / keepass-get.
#
#   auto-secret <NAME>          # print one secret to stdout
#   auto-secret --list          # list allowlisted names (no values)
#   source auto-secret          # defines get_secret() with in-process memo
#
# Seed/update a value (reads the secret from stdin, never argv):
#   auto-secret-set <NAME>

set -euo pipefail

NS="karl-auto"
# Explicit allowlist — the real scoping boundary. Add names here deliberately.
ALLOWED=(
  MCP_BEARER_TOKEN
  GITHUB_TOKEN
  TODOIST_TOKEN
  TWILIO_ACCOUNT_SID
  TWILIO_AUTH_TOKEN
  TWILIO_FROM
  TWILIO_TO
  NWB_POSTGRES_READONLY_URL
)

LOG_DIR="${KARL_AUTO_LOG_DIR:-$HOME/karl-infra/logs}"
LOG_FILE="$LOG_DIR/auto-secret-reads.log"

_auto_secret_allowed() {
  local n="$1" a
  for a in "${ALLOWED[@]}"; do [[ "$a" == "$n" ]] && return 0; done
  return 1
}

_auto_secret_log() {
  local name="$1"
  ( umask 077; mkdir -p "$LOG_DIR" ) 2>/dev/null || return 0
  local parent
  parent="$(ps -o comm= -p "$PPID" 2>/dev/null | tr -d '\n' || true)"
  ( umask 077; printf '%s\tread\t%s\tppid=%s\t%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "$PPID" "${parent:-?}" >> "$LOG_FILE" ) 2>/dev/null || true
}

_auto_secret_fetch() {
  local name="$1"
  if ! _auto_secret_allowed "$name"; then
    echo "auto-secret: '$name' is not allowlisted (see ALLOWED in $(command -v auto-secret 2>/dev/null || echo auto-secret))" >&2
    return 1
  fi
  local val
  if ! val="$(security find-generic-password -a "$USER" -s "$NS:$name" -w 2>/dev/null)"; then
    echo "auto-secret: '$NS:$name' not in Keychain. Seed it with: auto-secret-set $name" >&2
    return 2
  fi
  _auto_secret_log "$name"
  printf '%s' "$val"
}

# ---- sourced mode: expose get_secret() with an in-process memo ----------------
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  declare -A _AUTO_SECRET_MEMO 2>/dev/null || true
  get_secret() {
    local name="${1:?usage: get_secret NAME}"
    if [[ -n "${_AUTO_SECRET_MEMO[$name]+x}" ]]; then
      printf '%s' "${_AUTO_SECRET_MEMO[$name]}"; return 0
    fi
    local v; v="$(_auto_secret_fetch "$name")" || return $?
    _AUTO_SECRET_MEMO[$name]="$v"
    printf '%s' "$v"
  }
  return 0
fi

# ---- CLI mode -----------------------------------------------------------------
case "${1:-}" in
  --list|-l)
    printf '%s\n' "${ALLOWED[@]}"
    exit 0 ;;
  ""|-h|--help)
    echo "usage: auto-secret <NAME> | auto-secret --list" >&2
    exit 1 ;;
  *)
    _auto_secret_fetch "$1" ;;
esac
