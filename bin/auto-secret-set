#!/usr/bin/env bash
# Store/update a secret in the `karl-auto:` silent-read namespace.
#
# The value is read from STDIN, so it never appears in YOUR shell command line
# or shell history (it lives only in this script's memory, then is handed to the
# `security` tool). Items are created with `-T /usr/bin/security` so the
# `security` CLI (and thus `auto-secret`) reads them without a GUI prompt.
#
#   printf '%s' 'the-secret-value' | auto-secret-set MCP_BEARER_TOKEN
#   auto-secret-set TWILIO_TO            # then type/paste the value, Ctrl-D
#
# Re-running replaces the item (delete + add) so the ACL is always reset to the
# silent-read trust list.
#
# Note: macOS `security` takes the password as an argv option, so the plaintext
# is briefly visible in `ps` for the life of that one `security` process. On a
# single-user Mac that is an accepted trade-off; we just keep it out of history.

set -euo pipefail

NS="karl-auto"
ALLOWED=(
  MCP_BEARER_TOKEN
  GITHUB_TOKEN
  TODOIST_TOKEN
  TWILIO_ACCOUNT_SID
  TWILIO_AUTH_TOKEN
  TWILIO_FROM
  TWILIO_TO
  NWB_POSTGRES_READONLY_URL
)

NAME="${1:?usage: auto-secret-set <NAME>   (value on stdin)}"

ok=0
for a in "${ALLOWED[@]}"; do [[ "$a" == "$NAME" ]] && ok=1; done
if [[ "$ok" -ne 1 ]]; then
  echo "auto-secret-set: '$NAME' is not allowlisted (add it to ALLOWED in auto-secret and auto-secret-set first)" >&2
  exit 1
fi

# Read value from stdin (strip a single trailing newline only).
VALUE="$(cat)"
if [[ -z "$VALUE" ]]; then
  echo "auto-secret-set: empty value on stdin; refusing to store" >&2
  exit 1
fi

# Replace so the ACL is reset to the silent-read trust list every time.
security delete-generic-password -a "$USER" -s "$NS:$NAME" >/dev/null 2>&1 || true
security add-generic-password -a "$USER" -s "$NS:$NAME" -T /usr/bin/security -U -w "$VALUE" >/dev/null
echo "stored $NS:$NAME (silent-read; len ${#VALUE})"
