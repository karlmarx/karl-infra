# Copy to .env and fill in (gitignored). Source via `set -a; source .env; set +a`
# or let the runner load it automatically via python-dotenv.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Model. Override per-run with TRIAGE_MODEL=...
TRIAGE_MODEL=claude-opus-4-7

# --- Supabase ---
SUPABASE_URL=https://bupevfrihjjhlxdknpez.supabase.co
# Grab from Supabase Dashboard → Project Settings → API → "service_role" secret.
# Server-side only — NEVER in browser code, NEVER commit this.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Gmail access ---
# Pick ONE: IMAP (simpler, app password) or MCP (OAuth via Google Cloud).
# If both are configured, IMAP wins.

# Option A: IMAP with an app password (https://myaccount.google.com/apppasswords)
# Recommended for single-user mailboxes — no Google Cloud project required.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Option B: Gmail MCP server (OAuth). Requires gcp-oauth.keys.json at
# ~/.gmail-mcp/ and a one-time browser auth via `npx ... auth`.
GMAIL_MCP_COMMAND=npx
GMAIL_MCP_ARGS=-y @gongrzhe/server-gmail-autoauth-mcp

# --- GitHub ---
GITHUB_TOKEN=ghp_...
# Default repo for triaged issues if Claude doesn't specify (owner/repo).
DEFAULT_GH_REPO=karlmarx/karl-command-center

# --- Todoist ---
TODOIST_TOKEN=...

# --- Twilio (for urgent SMS) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+1...
TWILIO_TO=+1...

# --- NWB Fit user activity (optional) ---
# Read-only Neon Postgres connection for nwb-plan. Powers the
# lookup_nwbfit_user_activity tool. Get via:
#   cd ~/nwb-plan && vercel env pull && grep POSTGRES_URL_NON_POOLING .env.local
# Use a read-only Neon role if you can:
#   Neon Console → Roles → create 'triage_readonly',
#   then GRANT SELECT ON workout_sessions TO triage_readonly;
# Leave blank to disable the tool (it will report "not configured").
NWB_POSTGRES_URL=

# --- Guardrails ---
# Comma-separated lowercase email addresses. Only emails FROM these get triaged.
SENDER_ALLOWLIST=karlmarx9193@gmail.com,k@93.fyi
# Hard daily cap. Runner becomes read-only when exceeded.
DAILY_BUDGET_USD=1.00
# Max triages per UTC day.
MAX_TRIAGES_PER_DAY=50
# Max tokens per single triage agent run.
MAX_TOKENS_PER_TRIAGE=12000
# Max agent iterations per triage.
MAX_ITERATIONS=6
