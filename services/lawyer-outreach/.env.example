# Lawyer outreach service — environment.
# Copy to .env, chmod 600, and fill from KeePass / 1Password.

# --- Anthropic ---
ANTHROPIC_API_KEY=
OUTREACH_MODEL=claude-opus-4-7

# --- Gmail SMTP/IMAP ---
# Use a Gmail App Password (https://myaccount.google.com/apppasswords),
# NOT your account password. 2FA must be enabled.
GMAIL_USER=karlmarx9193@gmail.com
GMAIL_APP_PASSWORD=
FROM_NAME=Karl Marx
REPLY_TO=karlmarx9193@gmail.com

# --- Behavior ---
# "draft" = write a .eml file under logs/ for review (safe default)
# "auto"  = actually send via SMTP / submit forms via Playwright
SEND_MODE=draft

# Cap how many firms we'll contact per UTC day.
MAX_FIRMS_PER_DAY=3
# Minimum seconds between sends, so we don't burst a single batch.
MIN_SECONDS_BETWEEN_SENDS=900
# Soft cap on Claude $ spend per day (cents-accurate).
DAILY_BUDGET_USD=1.0

# Toggle subsystems.
ENABLE_WEB_FORMS=true
ENABLE_REPLY_SCAN=true

# Optional integrations.
TODOIST_TOKEN=

# Paths. Defaults sit under ~/karl-infra-state/lawyer-outreach/ on the Mac.
# Uncomment to override.
# OUTREACH_STATE_ROOT=
# STATE_DB=
# SCREENSHOTS_DIR=
# LOG_DIR=
# KILL_SWITCH_FILE=
